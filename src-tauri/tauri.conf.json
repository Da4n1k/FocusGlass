{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FocusGlass",
  "version": "1.0.0",
  "identifier": "com.neurotech.focusglass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FocusGlass",
        "label": "main",
        "width": 1240,
        "height": 820,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
